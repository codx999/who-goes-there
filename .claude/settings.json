{
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run python scripts/guard_data.py:*)",
      "Bash(bash scripts/check.sh)",
      "Bash(bash scripts/risk_files.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git check-ignore:*)",
      "Bash(git merge-base:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./.env.local)",
      "Read(/data/**)",
      "Read(/models/**)",
      "Read(/outputs/**)"
    ]
  }
}
